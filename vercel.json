{
  "buildCommand": "cd apps/portal && npm run build",
  "devCommand": "cd apps/portal && npm run dev",
  "installCommand": "npm install && cd apps/portal && npm install",
  "framework": "nextjs",
  "outputDirectory": "apps/portal/.next",
  "regions": ["hnd1"],
  "functions": {
    "src/app/api/service-application/route.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}